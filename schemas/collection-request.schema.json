{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mrcakes931.dev/osint/collection-request/1.0.0",
  "title": "OSINT Collection Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_version",
    "request_id",
    "source_id",
    "purpose",
    "target_type",
    "target_ref",
    "requested_fields",
    "max_records",
    "max_bytes",
    "requested_rate_per_minute",
    "retention_days",
    "timeout_seconds",
    "max_retries",
    "requested_at",
    "expires_at",
    "requester_id",
    "legal_review_ref",
    "privacy_review_ref",
    "policy_decision_ref",
    "emergency_state_ref",
    "compliance_review_ref",
    "audit_event_ref"
  ],
  "properties": {
    "request_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "source_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100
    },
    "purpose": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100
    },
    "target_type": {
      "enum": [
        "public_dataset",
        "public_publication",
        "public_registry",
        "public_organization",
        "public_software_project"
      ]
    },
    "target_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "requested_fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "dataset_metadata",
          "publication_metadata",
          "public_registry_metadata",
          "organization_public_disclosure",
          "software_release_metadata",
          "document_metadata",
          "terms_license_metadata"
        ]
      }
    },
    "max_records": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "max_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "requested_rate_per_minute": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "retention_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "max_retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "requester_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "legal_review_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "privacy_review_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "policy_decision_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "emergency_state_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "compliance_review_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "audit_event_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    }
  }
}
